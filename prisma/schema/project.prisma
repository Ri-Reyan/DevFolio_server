enum ChunkSource {
  README
  FILE_TREE
  KEY_FILE
  DEPENDENCY_MANIFEST
}

enum PerfStatus {
  PENDING
  RUNNING
  COMPLETED
  SKIPPED
  FAILED
}

model Project {
  id            String              @id @default(uuid()) @db.Uuid
  profileId     String              @db.Uuid
  githubRepoId  BigInt
  name          String
  fullName      String
  description   String?
  htmlUrl       String
  defaultBranch String
  language      String?
  topics        String[]            @default([])
  isFork        Boolean             @default(false)
  isArchived    Boolean             @default(false)
  stars         Int                 @default(0)
  pushedAt      DateTime?
  syncedAt      DateTime            @default(now())
  profile       Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  chunks        ProjectChunk[]
  perfReports   PerformanceReport[]
  jobLinks      ResumeJobProject[]

  @@unique([profileId, githubRepoId])
  @@index([profileId, pushedAt])
}

model ProjectChunk {
  id               String      @id @default(uuid()) @db.Uuid
  projectId        String      @db.Uuid
  profileId        String      @db.Uuid                      // mandatory tenant filter for vector query
  source           ChunkSource
  section          String?
  content          String
  tokenCount       Int
  pineconeVectorId String?                                   // Pinecone vector ID ({profileId}#{chunkId})
  commitSha        String?
  createdAt        DateTime    @default(now())
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile          Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, projectId])
}

model PerformanceReport {
  id            String     @id @default(uuid()) @db.Uuid
  projectId     String     @db.Uuid
  jobId         String?    @db.Uuid
  liveUrl       String?
  status        PerfStatus @default(PENDING)
  performance   Int?
  accessibility Int?
  bestPractices Int?
  seo           Int?
  lighthouseVer String?
  skipReason    String?
  rawJson       Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime   @default(now())
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
